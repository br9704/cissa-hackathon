# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Node
node_modules/
dist/
build/
.next/
*.log
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Owner rule 2026-08-22: these two never get committed
CLAUDE.md
ENGINEERPROMPT.md
engineerprompt.md

# Generated by `pnpm --filter @continuity/core seed`. Derived from a committed seed and
# a committed generator, so committing it would be storing an output next to the thing
# that produces it. The provenance file in ml/results records its sha256 instead.
ml/data/
ml/runs/

# Built by scripts/make-demo-repo.sh. A git repository nested inside another one confuses
# every tool that walks the tree, and the commits need to be reproducible for the video.
demo/
ml/.venv/

# ml/results/summary.json is COMMITTED on purpose. It is the artifact the honest-claims
# rule points at: no number appears in the UI, the README or the pitch that a committed
# file cannot back, and this is that file. The adapter weights and the run logs are not
# committed, but their hashes are recorded inside it.
ml/runs/*/adapters/
ml/runs/*/train.log

# Screen takes for the video edit, regenerated by scripts/capture-beats.ts against the
# frozen seed. The manifest IS committed, because it records what was captured and what
# could not be.
docs/beats/*.png
