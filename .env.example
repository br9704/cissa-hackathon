# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# The VITE_ prefix is not decoration: anything carrying it is baked into the JavaScript that
# ships to a browser. A service role key with a VITE_ prefix is a public service role key.

# --- Supabase -----------------------------------------------------------------------------
# Public by design. The anon key is safe in a browser bundle BECAUSE row level security is
# what actually protects the data. If RLS is off, this key is a door.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely. Never prefix this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inference ----------------------------------------------------------------------------
# Optional. Without a key the app falls back to in browser retrieval, which needs no key and
# is the primary path anyway. Drafting and debrief degrade honestly rather than pretending.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# The local bridge, for development on a machine with a Claude subscription. Using a personal
# subscription to serve a deployed app is prohibited by Anthropic's terms, which is why this
# is loopback only.
CLAUDE_BRIDGE_URL=http://127.0.0.1:8787

# The fine tuned firm model, served by ml/src/serve_firm.sh. The app health checks this and
# falls back to retrieval when it does not answer.
FIRM_MODEL_URL=http://127.0.0.1:8081
